#!/usr/bin/env python3

with open('/sessions/vigilant-ecstatic-sagan/mnt/outputs/FORGE_Concept.html', 'r') as f:
    html = f.read()

original_len = len(html)
changes = []

def rep(old, new, label):
    global html
    count = html.count(old)
    if count == 0:
        print(f"  MISS: {label}")
    else:
        html = html.replace(old, new)
        changes.append(f"  OK ({count}x): {label}")

# ===== 1. NAME & TITLE =====
rep('FORGE — Force Optimization &amp; Readiness Generation Engine | Concept Document',
    'TITAN — Talent Intelligence and Assignment Network | Concept Document', 'title tag')
rep('Force Optimization &amp; Readiness Generation Engine',
    'Talent Intelligence and Assignment Network', 'brand subtitle HTML entity')
rep('Force Optimization & Readiness Generation Engine',
    'Talent Intelligence and Assignment Network', 'brand subtitle raw ampersand')
rep('FORGE', 'TITAN', 'all FORGE → TITAN')

# ===== 2. HERO =====
rep('<p class="hero-sub">One system. One record per Marine. One source of truth — from accession to final retirement. The Marine Corps talent management platform the HRDP mandates but has never had.</p>',
    '<p class="hero-sub">Talent intelligence, not just talent management. One integration layer connecting 15+ fragmented systems to a single authoritative record — turning manpower data into decision advantage for commanders, monitors, analysts, and Marines alike.</p>', 'hero subtitle')
rep('<span class="hero-badge hb-white">Replaces 13+ Systems</span>',
    '<span class="hero-badge hb-white">Unifies 15+ Systems</span>', 'hero badge replaces count')
rep('    <div class="hero-stat"><div class="num">13+</div><div class="lbl">Legacy systems retired</div></div>',
    '    <div class="hero-stat"><div class="num">15+</div><div class="lbl">Fragmented systems unified</div></div>', 'hero stat systems')

# ===== 3. EXEC SUMMARY =====
rep('<p class="section-lead">TITAN is the Marine Corps\' missing institutional capability — a modern, unified talent management platform that replaces 13+ disconnected legacy systems with a single authoritative record, real-time data, and AI-augmented decision support across the full HRDP cycle.</p>',
    '<p class="section-lead">TITAN is the Marine Corps\' missing institutional capability — a Talent Intelligence platform that transforms fragmented manpower data into decision advantage. The root problem is not that MCTFS is wrong; it is that nothing connects back to it. Talent management is not a system — it is a <em>capability</em> TITAN enables. TITAN is the connective tissue that was never built.</p>', 'exec summary lead')

rep('<strong>The core problem in one sentence:</strong> The Marine Corps cannot execute merit-based talent management because its authoritative pay and personnel system (MCTFS) is architecturally isolated from every downstream system that consumes its data — forcing monitors, planners, and commanders to make consequential decisions from fragmented, stale, manually reconciled information.',
    '<strong>The core problem in one sentence:</strong> The Marine Corps cannot execute merit-based talent management not because MCTFS is wrong, but because nothing connects back to it. Every downstream system that should feed MCTFS — performance records, billet structures, retention actions, planning models — operates in isolation. TITAN is the connective tissue the HRDP mandates but has never had.', 'core problem box')

